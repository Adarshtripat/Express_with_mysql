<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        input{
            height: 30px;
            width: 200px;
            margin: 3px;
        }
        #btn{
            background-color: red;
            color: white;
        }
        #rst{
            background-color: green;
            color: white;
        }

    </style>

</head>
<body>
    <%- include('./userHeader')%>
   <center>
    <form action="/user/updateUser" method="post">
        <table>
            <caption>
                <h3>Update From</h3>
            </caption>
            <tbody>
                <tr>
                    
                    <td>
                        Username:<br>
                        <input  value="<%=userData.username%>" type="text"  placeholder="Enter Username" name="username" >
                    </td>
                </tr>
                <tr>
                    <td>
                        Email:<br>
                        <input readonly value="<%=userData.email%>" type="text" placeholder="Enter Email" name="email">
                    </td>
                </tr>
                <tr>  
                    <td>
                        Password:<br>
                        <input value="<%=userData.password%>" type="text" placeholder="Enter password" name="password">
                    </td>
                </tr>
                <tr>
                    
                    <td>
                        Address:<br>
                        <textarea  rows="3" cols="28" "Enter Address" name="address"><%=userData.address%></textarea>
                    </td>
                </tr>
                <tr>
                    <td>
                        <input type="submit" id="btn" value="update">
                        <br>
                        <input type="reset" id="rst" value="Reset">
                    </td>
                </tr>
            </tbody>
        </table>
    </form>
   </center>
</body>
</html>